# 支持多个 URL，以英文逗号分隔
TARGET_URLS=https://example.com,https://www.example.org

# 每一轮执行完全部 URL 后，随机等待 6～26 分钟
MIN_INTERVAL_MINUTES=6
MAX_INTERVAL_MINUTES=26

# 单个页面最大打开时间：60 秒
PAGE_TIMEOUT_MS=60000

# 页面基本加载完成后，额外等待时间：3 秒
POST_LOAD_WAIT_MS=3000

# Linux 无图形服务器建议设为 true
HEADLESS=true

# 是否保存页面截图
SAVE_SCREENSHOTS=true

# 截图保存路径；请确保 Node.js 运行账号具备写入权限
SCREENSHOT_DIR=./output/screenshots
